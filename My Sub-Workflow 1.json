        "jsCode": "var data = $input.first().json.stdout;\nvar salida = [];\n\nfor (const element of JSON.parse(data)) {\n  var rentabilidad = element.rentabilidad;\n  rentabilidad = rentabilidad.replace(\"%\", \"\");\n  rentabilidad = rentabilidad.replace(\"+\", \"\");\n\n  salida.push(\n    {\n      name : element.name,\n      rentabilidad : rentabilidad\n    }\n  );\n}\n\nreturn salida;"
