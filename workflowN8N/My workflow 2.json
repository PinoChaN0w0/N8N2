        "jsCode": "var data = $input.first().json.stdout;\nvar salida= [];\nlet  i = 0;\nfor (const element of JSON.parse(data)) {\n  let variacion = element.variacion7;\n  variacion     = variacion.replace(\"%\", \"\");\n  let price     = element.price;\n  price         = price.replace(\"$\",\"\");\n  price         = price.replace(\",\", \"\");\n  i++;\n  if(i <= 3){\n    salida.push(\n     {\n       variacion : variacion,\n       price : price,\n       name  : element.name,\n       \n     }\n   );\n  }\n   \n  \n}\n\nreturn salida;"
      },
